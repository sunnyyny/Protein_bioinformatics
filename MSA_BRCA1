# ============================================================
# BARD1 DOMAIN-FOCUSED MULTIPLE SEQUENCE ALIGNMENT
# ============================================================

from Bio import SeqIO, AlignIO
from Bio.Seq import Seq
from Bio.SeqRecord import SeqRecord
from Bio.Align import PairwiseAligner
from Bio.Align import substitution_matrices
import subprocess


# ============================================================
# 1. INPUT FILE
# ============================================================

bard1_file = r"C:\Users\User\Downloads\BARD1_seq.txt"


# ============================================================
# 2. READ ORIGINAL SEQUENCES
# ============================================================

records = list(
    SeqIO.parse(bard1_file, "fasta")
)

print("Number of sequences:", len(records))


# ============================================================
# 3. REMOVE OLD ALIGNMENT GAPS
# ============================================================

cleaned_records = []

for record in records:

    cleaned_seq = (
        str(record.seq)
        .replace("-", "")
        .replace(".", "")
        .upper()
    )

    cleaned_records.append(
        SeqRecord(
            Seq(cleaned_seq),
            id=record.id,
            description=""
        )
    )


# ============================================================
# 4. SET UP LOCAL ALIGNER
# ============================================================

matrix = substitution_matrices.load("BLOSUM62")

aligner = PairwiseAligner()

aligner.mode = "local"

aligner.substitution_matrix = matrix

aligner.open_gap_score = -10
aligner.extend_gap_score = -0.5


# ============================================================
# 5. FIRST SEQUENCE = DOMAIN REFERENCE
# ============================================================

reference_record = cleaned_records[0]

reference_seq = str(
    reference_record.seq
)

print("\nReference:", reference_record.id)
print("Reference length:", len(reference_seq))


# ============================================================
# 6. CREATE LIST OF HOMOLOGOUS REGIONS
# ============================================================

domain_records = []


# ------------------------------------------------------------
# First record:
# keep the reference itself
# ------------------------------------------------------------

domain_records.append(
    SeqRecord(
        Seq(reference_seq),
        id=reference_record.id,
        description="reference"
    )
)


# ------------------------------------------------------------
# Other sequences:
# use local alignment to locate homologous region
# ------------------------------------------------------------

for target_record in cleaned_records[1:]:

    target_seq = str(
        target_record.seq
    )

    alignments = aligner.align(
        reference_seq,
        target_seq
    )

    best = alignments[0]


    # --------------------------------------------------------
    # Obtain aligned blocks in the target
    # --------------------------------------------------------

    target_blocks = best.aligned[1]


    # Beginning of first homologous block
    target_start = min(
        block[0]
        for block in target_blocks
    )


    # End of last homologous block
    target_end = max(
        block[1]
        for block in target_blocks
    )


    # --------------------------------------------------------
    # Extract the continuous homologous region
    # --------------------------------------------------------

    domain_seq = target_seq[
        target_start:target_end
    ]


    domain_records.append(
        SeqRecord(
            Seq(domain_seq),
            id=target_record.id,
            description=(
                f"local_region_"
                f"{target_start + 1}-{target_end}"
            )
        )
    )


    print(
        target_record.id,
        "extracted region:",
        f"{target_start + 1}-{target_end}",
        "length:",
        len(domain_seq)
    )


# ============================================================
# 7. WRITE DOMAIN-ONLY FASTA
# ============================================================

domain_fasta = (
    r"C:\Users\User\Downloads\BARD1_domain_regions.fasta"
)

SeqIO.write(
    domain_records,
    domain_fasta,
    "fasta"
)

print("\nDomain FASTA created:")
print(domain_fasta)

print(
    "Number of extracted sequences:",
    len(domain_records)
)


# ============================================================
# 8. RUN CLUSTALW THROUGH WSL
# ============================================================

wsl_domain_fasta = (
    "/mnt/c/Users/User/Downloads/"
    "BARD1_domain_regions.fasta"
)

print("\nRunning ClustalW...")

subprocess.run(
    [
        "wsl",
        "bash",
        "-lc",
        f"source ~/miniconda3/etc/profile.d/conda.sh && "
        f"conda activate proteinbio && "
        f"clustalw2 -INFILE={wsl_domain_fasta}"
    ],
    check=True
)

print("ClustalW finished.")


# ============================================================
# 9. READ NEW DOMAIN-FOCUSED MSA
# ============================================================

msa_file = (
    r"C:\Users\User\Downloads\BARD1_domain_regions.aln"
)

msa = AlignIO.read(
    msa_file,
    "clustal"
)


# ============================================================
# 10. PRINT FINAL MSA INFORMATION
# ============================================================

print("\n" + "=" * 80)
print("BARD1 DOMAIN-FOCUSED MSA")
print("=" * 80)

print(msa)

print(
    "\nNumber of sequences:",
    len(msa)
)

print(
    "Alignment length:",
    msa.get_alignment_length()
)


# ============================================================
# 11. SAVE FINAL MSA
# ============================================================

final_output = (
    r"C:\Users\User\Downloads\BARD1_final_domain_MSA.aln"
)

AlignIO.write(
    msa,
    final_output,
    "clustal"
)

print("\nFinal MSA saved as:")
print(final_output)
