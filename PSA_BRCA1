# ============================================================
# BARD1 LOCAL PAIRWISE SEQUENCE ALIGNMENT
# ============================================================

from Bio import SeqIO
from Bio.Align import PairwiseAligner
from Bio.Align import substitution_matrices


# ============================================================
# 1. INPUT FILE
# ============================================================

bard1_file = r"C:\Users\User\Downloads\BARD1_seq.txt"


# ============================================================
# 2. READ SEQUENCES
# ============================================================

records = list(
    SeqIO.parse(bard1_file, "fasta")
)

print("Number of sequences:", len(records))


# ============================================================
# 3. CLEAN SEQUENCES
#    Remove old MSA gaps and convert to uppercase
# ============================================================

cleaned_records = []

for record in records:

    cleaned_seq = (
        str(record.seq)
        .replace("-", "")
        .replace(".", "")
        .upper()
    )

    record.seq = type(record.seq)(cleaned_seq)

    cleaned_records.append(record)


# ============================================================
# 4. LOAD BLOSUM62
# ============================================================

matrix = substitution_matrices.load("BLOSUM62")


# ============================================================
# 5. SET UP LOCAL PAIRWISE ALIGNMENT
# ============================================================

aligner = PairwiseAligner()

# IMPORTANT:
# Local alignment finds the best matching region
# instead of forcing full-length proteins to align.
aligner.mode = "local"

aligner.substitution_matrix = matrix

aligner.open_gap_score = -10
aligner.extend_gap_score = -0.5


# ============================================================
# 6. FIRST SEQUENCE = REFERENCE
# ============================================================

reference_record = cleaned_records[0]
reference_seq = str(reference_record.seq)

print("\n" + "=" * 80)
print("REFERENCE")
print("=" * 80)

print("Reference ID:", reference_record.id)
print("Reference length:", len(reference_seq))


# ============================================================
# 7. VARIABLES FOR BEST RESULTS
# ============================================================

highest_score = float("-inf")
highest_score_target = None
highest_score_alignment = None
highest_score_identity = 0

highest_identity = float("-inf")
highest_identity_target = None
highest_identity_alignment = None
highest_identity_score = 0


# ============================================================
# 8. ALIGN REFERENCE AGAINST ALL OTHER SEQUENCES
# ============================================================

for number, target_record in enumerate(
    cleaned_records[1:],
    start=1
):

    target_seq = str(target_record.seq)

    alignments = aligner.align(
        reference_seq,
        target_seq
    )

    best = alignments[0]


    # --------------------------------------------------------
    # Calculate identity
    # --------------------------------------------------------

    counts = best.counts()

    identities = counts.identities
    mismatches = counts.mismatches

    compared = identities + mismatches

    if compared > 0:
        percent_identity = identities / compared * 100
    else:
        percent_identity = 0


    # --------------------------------------------------------
    # Find location of homologous region in target sequence
    # --------------------------------------------------------

    target_blocks = best.aligned[1]

    target_start = min(block[0] for block in target_blocks)
    target_end = max(block[1] for block in target_blocks)


    # Biopython uses zero-based coordinates internally.
    # +1 makes the displayed start coordinate easier to interpret.
    print("\n" + "=" * 80)

    print(
        f"PAIRWISE COMPARISON "
        f"{number} OF {len(cleaned_records) - 1}"
    )

    print("=" * 80)

    print("Reference:", reference_record.id)
    print("Target:   ", target_record.id)

    print("Reference length:", len(reference_seq))
    print("Target length:", len(target_seq))

    print("Alignment score:", best.score)

    print(
        f"Percent identity: "
        f"{percent_identity:.2f}%"
    )

    print(
        "Homologous target region:",
        f"{target_start + 1}-{target_end}"
    )

    print("\nLocal alignment:")
    print(best)


    # --------------------------------------------------------
    # Highest alignment score
    # --------------------------------------------------------

    if best.score > highest_score:

        highest_score = best.score
        highest_score_target = target_record.id
        highest_score_alignment = best
        highest_score_identity = percent_identity


    # --------------------------------------------------------
    # Highest percent identity
    # --------------------------------------------------------

    if percent_identity > highest_identity:

        highest_identity = percent_identity
        highest_identity_target = target_record.id
        highest_identity_alignment = best
        highest_identity_score = best.score


# ============================================================
# 9. FINAL PSA SUMMARY
# ============================================================

print("\n\n" + "#" * 80)
print("FINAL LOCAL PSA SUMMARY")
print("#" * 80)

print("\nHIGHEST ALIGNMENT SCORE")
print("=" * 80)

print("Reference:", reference_record.id)
print("Best target:", highest_score_target)
print("Score:", highest_score)
print(
    f"Percent identity: "
    f"{highest_score_identity:.2f}%"
)

print("\nAlignment:")
print(highest_score_alignment)


print("\nHIGHEST PERCENT IDENTITY")
print("=" * 80)

print("Reference:", reference_record.id)
print("Best target:", highest_identity_target)

print(
    f"Percent identity: "
    f"{highest_identity:.2f}%"
)

print("Score:", highest_identity_score)

print("\nAlignment:")
print(highest_identity_alignment)
